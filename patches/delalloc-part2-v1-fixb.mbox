+static loff_t ntfs_writeback_run_end(struct inode *inode, struct folio *folio,
+				     loff_t offset, unsigned int len,
+				     loff_t end)
+{
+	struct ntfs_inode *ni = NTFS_I(inode);
+	struct ntfs_volume *vol = ni->vol;
+	struct runlist_element *rl;
+	unsigned long flags;

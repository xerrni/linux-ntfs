+/*
+ * Longest mapping writeback asks for at a time.  With the end of the run
+ * (ntfs_writeback_run_end()) it bounds the scan of ntfs_dirty_range_end(),
+ * which runs for every new mapping: unbounded, a fully dirty file of many
+ * extents is scanned once per extent.  It is the largest cluster size
+ * (4096 sectors of 4 KiB), so a mapping can always cover a whole cluster.
+ */
+#define NTFS_WRITEBACK_MAP_MAX		SZ_16M

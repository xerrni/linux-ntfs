+							      vol->cluster_size),
+						   offset + len));
+			read_unlock_irqrestore(&ni->size_lock, flags);
+		}
+	}
+	up_read(&ni->runlist.lock);
+	return end;
+}
+
+/*
+ * Return where the run of dirty folios that follows @folio ends, at most
+ * @end.  A buffered write maps its whole range as delalloc before it copies
+ * the data folio by folio, so writeback that runs meanwhile must not allocate
+ * the clusters past the dirty folios: readers that do not take the inode
+ * lock (page faults, splice) would map the new clusters and read what they
+ * held before.
+ */
+static loff_t ntfs_dirty_range_end(struct address_space *mapping,
+				   struct folio *folio, loff_t end)
+{
+	pgoff_t index = folio_next_index(folio);
+	pgoff_t last = DIV_ROUND_UP(end, PAGE_SIZE);
+
+	while (index < last &&
+	       xa_get_mark(&mapping->i_pages, index, PAGECACHE_TAG_DIRTY))
+		index++;
+	return min_t(loff_t, (loff_t)index << PAGE_SHIFT, end);
+}
+
+/*
+ * With clusters larger than a page, a cluster can be only partly dirty while
+ * a buffered write is still copying into it.  Return where the mapping for
+ * the folio at @offset should end so that writeback does not allocate a
+ * partly dirty cluster other than the folio's own, and set @zero when the
+ * folio's own cluster has folios below initialized_size that are not dirty:
+ * it then has to be zeroed on disk before it is mapped.
+ */
+static loff_t ntfs_writeback_cluster_end(struct inode *inode,
+					 struct folio *folio, loff_t offset,
+					 loff_t end, bool *zero)
+{
+	struct ntfs_inode *ni = NTFS_I(inode);
+	u32 cs = ni->vol->cluster_size;
+	loff_t cstart = round_down(offset, cs);
+	loff_t cend = cstart + cs;
+	loff_t init = round_up(ni->initialized_size, PAGE_SIZE);
+	pgoff_t index;
+
+	*zero = false;
+	if (cs <= PAGE_SIZE)
+		return end;
+	if (end < min(cend, init))
+		*zero = true;
+	for (index = cstart >> PAGE_SHIFT; !*zero && index < folio->index &&
+	     ((loff_t)index << PAGE_SHIFT) < init; index++)
+		if (!xa_get_mark(&inode->i_mapping->i_pages, index,
+				 PAGECACHE_TAG_DIRTY))
+			*zero = true;
+	if (*zero || end < cend)
+		return min(end, cend);
+	return round_down(end, cs);
+}
+

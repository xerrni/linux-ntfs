From a51fbc4ef301cdbdb95a66e186e840620ad6978d Mon Sep 17 00:00:00 2001
From: Ernest Borowski <ernest.borowski.git@proton.me>
Date: Sat, 14 Nov 2026 15:55:13 +0100
Subject: [PATCH 2/5] ntfs: keep the allocation of a named stream on the stream
 inode

A named stream has an inode of its own, and ntfs_read_locked_attr_inode()
sets its i_blocks from the stream's allocated (or compressed) size, while
the base inode's i_blocks describes the unnamed data stream.  Once the
stream's runlist changes, though, ntfs_attr_update_meta(),
ntfs_non_resident_attr_shrink() and the rollback in
ntfs_non_resident_attr_expand() store the stream's size in the i_blocks
of the base inode.  st_blocks of the stream then stays at what it was
when the inode was read, and st_blocks of the file shows the size of its
stream, until the inodes are read again.

Reproducer: write 1 MiB into the named stream of an empty file and
fsync it.  stat of the stream reports 0 blocks and stat of the file
2048, and the other way round after a remount.

Set i_blocks on the stream inode for named streams.  The other
attribute inodes keep reporting on the base inode, so a directory still
shows the size of its index allocation.

Fixes: 495e90fa3348 ("ntfs: update attrib operations")
Cc: stable@vger.kernel.org
---
 fs/ntfs/attrib.c | 39 +++++++++++++++++++++++----------------
 1 file changed, 23 insertions(+), 16 deletions(-)

diff --git a/fs/ntfs/attrib.c b/fs/ntfs/attrib.c
index fa46c68fdc..ec4cef807c 100644
--- a/fs/ntfs/attrib.c
+++ b/fs/ntfs/attrib.c
@@ -3720,6 +3720,22 @@ int ntfs_attr_record_move_away(struct ntfs_attr_search_ctx *ctx, int extra)
 	return err;
 }
 
+/*
+ * Set i_blocks from the allocation of the attribute @ni.  A named stream
+ * reports its own allocation, like ntfs_read_locked_attr_inode() sets it;
+ * other attribute inodes (the directory index) report on @base_ni.
+ */
+static void ntfs_attr_update_i_blocks(struct ntfs_inode *ni,
+				      struct ntfs_inode *base_ni)
+{
+	struct inode *vi = VFS_I(ntfs_inode_is_named_stream(ni) ? ni : base_ni);
+
+	if (NInoSparse(ni) || NInoCompressed(ni))
+		vi->i_blocks = ni->itype.compressed.size >> 9;
+	else
+		vi->i_blocks = ni->allocated_size >> 9;
+}
+
 /*
  * If we are in the first extent, then set/clean sparse bit,
  * update allocated and compressed size.
@@ -3838,10 +3854,7 @@ static int ntfs_attr_update_meta(struct attr_record *a, struct ntfs_inode *ni,
 		a->data.non_resident.compressed_size = cpu_to_le64(new_compr_size);
 	}
 
-	if (NInoSparse(ni) || NInoCompressed(ni))
-		VFS_I(base_ni)->i_blocks = ni->itype.compressed.size >> 9;
-	else
-		VFS_I(base_ni)->i_blocks = ni->allocated_size >> 9;
+	ntfs_attr_update_i_blocks(ni, base_ni);
 	/*
 	 * Set FILE_NAME dirty flag, to update sparse bit and
 	 * allocated size in the index.
@@ -4593,14 +4606,10 @@ static int ntfs_non_resident_attr_shrink(struct ntfs_inode *ni,
 		/* Prepare to mapping pairs update. */
 		ni->allocated_size = ntfs_cluster_to_bytes(vol, first_free_vcn);
 
-		if (NInoSparse(ni) || NInoCompressed(ni)) {
-			if (nr_freed_clusters) {
-				ni->itype.compressed.size -=
-					ntfs_cluster_to_bytes(vol, nr_freed_clusters);
-				VFS_I(base_ni)->i_blocks = ni->itype.compressed.size >> 9;
-			}
-		} else
-			VFS_I(base_ni)->i_blocks = ni->allocated_size >> 9;
+		if ((NInoSparse(ni) || NInoCompressed(ni)) && nr_freed_clusters)
+			ni->itype.compressed.size -=
+				ntfs_cluster_to_bytes(vol, nr_freed_clusters);
+		ntfs_attr_update_i_blocks(ni, base_ni);
 
 		/* Write mapping pairs for new runlist. */
 		err = ntfs_attr_update_mapping_pairs_locked(ni, 0, ni);
@@ -4997,11 +5006,9 @@ static int ntfs_non_resident_attr_expand(struct ntfs_inode *ni, const s64 newsiz
 		if (__ntfs_attr_update_mapping_pairs(ni, 0, ni, true))
 			ntfs_error(sb, "Failed to restore old mapping pairs");
 
-		if (NInoSparse(ni) || NInoCompressed(ni)) {
+		if (NInoSparse(ni) || NInoCompressed(ni))
 			ni->itype.compressed.size =  org_compressed_size;
-			VFS_I(base_ni)->i_blocks = ni->itype.compressed.size >> 9;
-		} else
-			VFS_I(base_ni)->i_blocks = ni->allocated_size >> 9;
+		ntfs_attr_update_i_blocks(ni, base_ni);
 	}
 	if (!runlist_locked)
 		up_write(&ni->runlist.lock);
-- 

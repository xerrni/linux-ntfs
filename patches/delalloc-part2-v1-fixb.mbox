From 2c54b5ed4e5e806499693a0f7fdccb5b8027444a Mon Sep 17 00:00:00 2001
From: Ernest Borowski <ernest.borowski.git@proton.me>
Date: Sat, 14 Nov 2026 15:54:08 +0100
Subject: [PATCH 1/5] ntfs: take allocated delalloc clusters out of
 i_dealloc_clusters once

i_dealloc_clusters counts the delalloc clusters of an inode and is added
to st_blocks by getattr.  When writeback allocates a delalloc run,
ntfs_write_da_iomap_begin_non_resident() subtracts the allocated
clusters from it.  But when ntfs_attr_map_cluster() rewrites the mapping
pairs right away (update_mp: named streams, system files, and any file
once the volume has 5 % or less free space),
__ntfs_attr_update_mapping_pairs() has already recounted
i_dealloc_clusters from the runlist, so the run is subtracted twice and
st_blocks drops by the size of the run while the rest of the delayed
data is still not allocated.  On top of that, a failed allocation sets
i_dealloc_clusters to 0 although every delalloc run of the inode is
still there.

Reproducer: on a volume with 3 % free space write 1 MiB at 0 and 1 MiB
at 2 MiB of a new file, then sync_file_range() the first MiB.  st_blocks
goes from 4096 to 2048 although it is 4096 again after the second run is
written, and stays 4096 after a remount.

Subtract the run in ntfs_attr_map_cluster() on the path that does not
recount, and leave i_dealloc_clusters alone when the allocation fails.

Fixes: b041ca562526 ("ntfs: update iomap and address space operations")
Cc: stable@vger.kernel.org
---
 fs/ntfs/attrib.c | 7 +++++++
 fs/ntfs/iomap.c  | 9 +--------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/fs/ntfs/attrib.c b/fs/ntfs/attrib.c
index 4ec4ca3d87..fa46c68fdc 100644
--- a/fs/ntfs/attrib.c
+++ b/fs/ntfs/attrib.c
@@ -5690,6 +5690,13 @@ int ntfs_attr_map_cluster(struct ntfs_inode *ni, s64 vcn_start, s64 *lcn_start,
 		}
 	} else {
 		VFS_I(ni)->i_blocks += clu_count << (vol->cluster_size_bits - 9);
+		/*
+		 * Rewriting the mapping pairs above recounts
+		 * i_dealloc_clusters, so only this path takes the run out.
+		 */
+		if (was_delalloc)
+			ni->i_dealloc_clusters -= min_t(s64, clu_count,
+							ni->i_dealloc_clusters);
 		NInoSetRunlistDirty(ni);
 		mark_mft_record_dirty(base_ni);
 	}
diff --git a/fs/ntfs/iomap.c b/fs/ntfs/iomap.c
index bdb176fdd4..e284531dec 100644
--- a/fs/ntfs/iomap.c
+++ b/fs/ntfs/iomap.c
@@ -623,10 +623,8 @@ static int ntfs_write_da_iomap_begin_non_resident(struct inode *inode,
 			ntfs_iomap_flags & NTFS_IOMAP_FLAGS_WRITEBACK);
 	up_write(&ni->runlist.lock);
 	mutex_unlock(&mrec_ni->mrec_lock);
-	if (err) {
-		ni->i_dealloc_clusters = 0;
+	if (err)
 		return err;
-	}
 
 	iomap->bdev = inode->i_sb->s_bdev;
 	iomap->offset = offset;
@@ -664,11 +662,6 @@ static int ntfs_write_da_iomap_begin_non_resident(struct inode *inode,
 							  (start_lcn + lcn_count - 1) <<
 							  vol->cluster_size_bits,
 							  vol->cluster_size);
-		} else {
-			if (lcn_count > ni->i_dealloc_clusters)
-				ni->i_dealloc_clusters = 0;
-			else
-				ni->i_dealloc_clusters -= lcn_count;
 		}
 		if (err < 0)
 			return err;
-- 

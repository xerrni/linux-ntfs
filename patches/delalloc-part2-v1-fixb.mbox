From ed504a3b1e7619f5697c709761ebe7733dc44e93 Mon Sep 17 00:00:00 2001
From: Ernest Borowski <ernest.borowski.git@proton.me>
Date: Sat, 14 Nov 2026 16:09:19 +0100
Subject: [PATCH 4/5] ntfs: allocate delalloc clusters at writeback only for
 dirty folios

A buffered write into a hole maps its whole range as one delalloc run in
->iomap_begin() and then copies the data folio by folio.  Writeback that
runs meanwhile (the flusher, sync_file_range(), fadvise(DONTNEED),
FIEMAP_FLAG_SYNC) asks ntfs_write_da_iomap_begin_non_resident() for a
mapping from the first dirty folio to the end of the allocation, so
ntfs_attr_map_cluster() allocates the whole run, also the clusters whose
data has not been copied yet.  Readers that do not take the inode lock
(page faults, splice()) then map those clusters, find no folio in the
page cache, and read what the reused clusters held before, data of
deleted files.  The stale folios stay in the page cache.

Reproducer: fill the free space with a marker pattern and delete it,
create a sparse file, and fill its holes with buffered writes of 1 to 8
clusters while other processes call fadvise(DONTNEED) on the range being
written and read it through new mappings and splice().  With 4 KiB
clusters the marker shows up within seconds, with 64 KiB clusters too.

Ask for a mapping only up to the end of the dirty folios that follow the
one being written back.  Clusters larger than a page are allocated
whole, so with those also stop before a cluster that is only partly
dirty, and when the folio's own cluster has folios below
initialized_size that are not dirty, zero it on disk before it is
mapped, as for a write fault.  In the usual case every folio of a
delalloc cluster is dirty, since the buffered write zeroes the parts of
its edge clusters it does not cover, so that zeroing only happens while
a copy into the cluster is still going on.  The scan for dirty folios
runs for every new mapping, so it stops at the end of the run being
mapped and after 16 MiB: scanning to the end of the allocation made
fsync of a fully dirty 1 GiB file of 4000 extents take 98 to 172 s
instead of 0.36 to 0.63 s; with the bound it takes 0.29 to 0.57 s (QEMU,
RAM-backed loop device, 3 runs each).

Fixes: b041ca562526 ("ntfs: update iomap and address space operations")
Cc: stable@vger.kernel.org
---
 fs/ntfs/inode.c |   2 +
 fs/ntfs/inode.h |   6 ++
 fs/ntfs/iomap.c | 175 +++++++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 172 insertions(+), 11 deletions(-)

diff --git a/fs/ntfs/inode.c b/fs/ntfs/inode.c
index ba00c09e1b..121f6fa718 100644
--- a/fs/ntfs/inode.c
+++ b/fs/ntfs/inode.c
@@ -558,6 +558,8 @@ void __ntfs_init_inode(struct super_block *sb, struct ntfs_inode *ni)
 	ni->linuxflags = 0;
 	ni->i_dealloc_clusters = 0;
 	ni->alloc_seq = 0;
+	ni->uncopied_start = 0;
+	ni->uncopied_end = 0;
 }
 
 /*
diff --git a/fs/ntfs/inode.h b/fs/ntfs/inode.h
index 9ccaf55682..79e7301de5 100644
--- a/fs/ntfs/inode.h
+++ b/fs/ntfs/inode.h
@@ -96,6 +96,10 @@ enum ntfs_inode_mutex_lock_class {
  * @i_dealloc_clusters: delayed allocated clusters.
  * @alloc_seq: bumped under the runlist lock whenever clusters are allocated
  *   for a hole or delalloc run; a buffered write's ->iomap_valid() uses it.
+ * @uncopied_start: start of the part of the delalloc mapping of the buffered
+ *   write in progress that the write has not copied into the page cache yet;
+ *   writeback does not allocate it.  Guarded by @size_lock.
+ * @uncopied_end: end of that part; none when not above @uncopied_start.
  * @target: symlink buffer.
  * @linuxflags: Linux-specific file attributes loaded from the $LINUXFLAGS EA.
  */
@@ -147,6 +151,8 @@ struct ntfs_inode {
 	} ext;
 	unsigned int i_dealloc_clusters;
 	unsigned int alloc_seq;
+	loff_t uncopied_start;
+	loff_t uncopied_end;
 	__le32 reparse_tag;
 	__le32 reparse_flags;
 	char *target;
diff --git a/fs/ntfs/iomap.c b/fs/ntfs/iomap.c
index b7142d633f..b41fac0c95 100644
--- a/fs/ntfs/iomap.c
+++ b/fs/ntfs/iomap.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2025 LG Electronics Co., Ltd.
  */
 
+#include <linux/sizes.h>
 #include <linux/workqueue.h>
 #include <linux/writeback.h>
 
@@ -16,12 +17,29 @@
 /* iomap->flags: ->iomap_begin() turned a hole into this delalloc mapping */
 #define NTFS_IOMAP_F_WAS_HOLE		IOMAP_F_PRIVATE
 
+/*
+ * A buffered write (the inode lock allows one at a time) maps its range as
+ * delalloc before it copies the data folio by folio.  Record the part of the
+ * mapping it has not copied yet: writeback must not allocate it, see
+ * ntfs_writeback_run_end().
+ */
+static void ntfs_set_uncopied(struct ntfs_inode *ni, loff_t start, loff_t end)
+{
+	unsigned long flags;
+
+	write_lock_irqsave(&ni->size_lock, flags);
+	ni->uncopied_start = start;
+	ni->uncopied_end = end;
+	write_unlock_irqrestore(&ni->size_lock, flags);
+}
+
 static void ntfs_iomap_put_folio_non_resident(struct inode *inode, loff_t pos,
 					      unsigned int len, struct folio *folio)
 {
 	struct ntfs_inode *ni = NTFS_I(inode);
 	unsigned long sector_size = 1UL << inode->i_blkbits;
 	loff_t start_down, end_up, init;
+	unsigned long flags;
 
 	start_down = round_down(pos, sector_size);
 	end_up = (pos + len - 1) | (sector_size - 1);
@@ -62,6 +80,14 @@ static void ntfs_iomap_put_folio_non_resident(struct inode *inode, loff_t pos,
 				    offset2,
 				    folio_size(folio));
 	}
+	/* [pos, pos + len) is copied, or zeroed, and dirty */
+	if (len) {
+		write_lock_irqsave(&ni->size_lock, flags);
+		if (ni->uncopied_start < ni->uncopied_end &&
+		    pos <= ni->uncopied_start && ni->uncopied_start < pos + len)
+			ni->uncopied_start = pos + len;
+		write_unlock_irqrestore(&ni->size_lock, flags);
+	}
 	folio_unlock(folio);
 	folio_put(folio);
 }
@@ -517,17 +543,19 @@ static int ntfs_write_simple_iomap_begin_non_resident(struct inode *inode, loff_
 			ni->i_dealloc_clusters += max_clu_count;
 		}
 		iomap->validity_cookie = ntfs_alloc_cookie(ni);
-		up_write(&ni->runlist.lock);
-		mutex_unlock(&mrec_ni->mrec_lock);
-
-		if (lcn < LCN_DELALLOC)
-			ntfs_hold_dirty_clusters(vol, max_clu_count);
 
 		rl_length = ntfs_cluster_to_bytes(vol, max_clu_count);
 		if (length > rl_length - vcn_ofs)
 			iomap->length = rl_length - vcn_ofs;
 		else
 			iomap->length = length;
+		/* before writeback can see the new delalloc clusters */
+		ntfs_set_uncopied(ni, offset, offset + iomap->length);
+		up_write(&ni->runlist.lock);
+		mutex_unlock(&mrec_ni->mrec_lock);
+
+		if (lcn < LCN_DELALLOC)
